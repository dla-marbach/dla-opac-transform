{
  "name": "dla-opac-transform",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "remoteUser": "vscode",
  // OpenRefine, orcli und Solr in festen Versionen aus dem Taskfile ins Arbeitsverzeichnis laden
  "postCreateCommand": "task install",
  "forwardPorts": [3333, 8983],
  "portsAttributes": {
    "3333": {
      "label": "OpenRefine"
    },
    "8983": {
      "label": "Solr"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": []
    }
  }
}
